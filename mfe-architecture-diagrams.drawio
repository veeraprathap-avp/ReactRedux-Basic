        <mxCell id="f5" value="attachShadow + mount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="connect" target="react2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="unmount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="disconnect" target="react2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

