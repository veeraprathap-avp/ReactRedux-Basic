<mxfile host="app.diagrams.net" modified="2026-09-23T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="containerId-diagram" name="containerId Approach">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Host JSP outer container -->
        <mxCell id="host" value="Host JSP Page (global scope)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1000" height="330" as="geometry" />
        </mxCell>

        <!-- div#mfe-container -->
        <mxCell id="div" value="&amp;lt;div id=&quot;mfe-container&quot;&amp;gt;&amp;lt;/div&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- AWS S3 bucket -->
        <mxCell id="s3" value="AWS S3 Bucket&#10;hosts mfe.bundle.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="-280" y="200" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- script tag -->
        <mxCell id="script" value="&amp;lt;script src=&quot;mfe.bundle.js&quot;&amp;gt;&amp;lt;/script&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- init call -->
        <mxCell id="init" value="window.MfeX.init(&#39;mfe-container&#39;, props)&#10;(manual JS call, host must know exact API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- MFE Bundle -->
        <mxCell id="bundle" value="MFE JS Bundle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="180" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- getElementById -->
        <mxCell id="getel" value="document.getElementById(containerId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- React root -->
        <mxCell id="react" value="ReactDOM.createRoot(div).render(&amp;lt;App/&amp;gt;)&#10;Renders directly into global DOM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- No unmount warning -->
        <mxCell id="warning" value="No standard unmount hook.&#10;Cleanup is manual — easy to forget.&#10;Global CSS/JS shared — style collisions possible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="290" width="880" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e0" value="GET https://s3.../mfe.bundle.js" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="s3" target="script">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="script" target="init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="init" target="bundle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="finds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bundle" target="getel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="getel" target="div">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bundle" target="react">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="mounts into" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="react" target="div">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="webcomponent-diagram" name="Web Component Approach">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Host JSP outer container -->
        <mxCell id="host2" value="Host JSP Page" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1000" height="400" as="geometry" />
        </mxCell>

        <!-- custom element tag -->
        <mxCell id="tag" value="&amp;lt;mfe-user-profile user-id=&quot;123&quot;&amp;gt;&amp;lt;/mfe-user-profile&amp;gt;&#10;(plain HTML, no JS call needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- AWS S3 bucket -->
        <mxCell id="s32" value="AWS S3 Bucket&#10;hosts mfe.bundle.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="-280" y="190" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- script registers -->
        <mxCell id="script2" value="&amp;lt;script src=&quot;mfe.bundle.js&quot;&amp;gt;&amp;lt;/script&amp;gt;&#10;registers custom element" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Custom Element Class -->
        <mxCell id="ce" value="Custom Element Class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="100" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- connectedCallback -->
        <mxCell id="connect" value="connectedCallback()&#10;called automatically by browser&#10;on mount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="180" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- disconnectedCallback -->
        <mxCell id="disconnect" value="disconnectedCallback()&#10;called automatically by browser&#10;on removal — root.unmount()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="260" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Shadow DOM boundary -->
        <mxCell id="shadow" value="Shadow DOM (isolated)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="240" height="140" as="geometry" />
        </mxCell>

        <!-- React root inside shadow -->
        <mxCell id="react2" value="ReactDOM.createRoot(shadowRoot)&#10;.render(&amp;lt;App/&amp;gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Benefit note -->
        <mxCell id="benefit" value="Styles and JS fully encapsulated — cannot leak in or out.&#10;Mount/unmount lifecycle is automatic and guaranteed — no manual cleanup, no memory leaks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="f0" value="GET https://s3.../mfe.bundle.js" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="s32" target="script2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="script2" target="ce">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="registers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="ce" target="tag">
          <mxGeometry relative="1" as="geometry" />
